{
    "name": "hypejunction/hypestash",
    "type": "elgg-plugin",
    "description": "API for caching common counters to reduce DB queries",
    "homepage": "https://github.com/hypeJunction/hypestash",
    "keywords": [
        "elgg",
        "plugin"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "extra": {
        "installer-name": "hypestash",
        "elgg-plugin": {
            "id": "hypestash"
        }
    },
    "require": {
        "php": ">=8.2",
        "elgg/elgg": "^5.0",
        "composer/installers": "^2.0"
    },
    "autoload": {
        "psr-0": {
            "": "classes/"
        },
        "files": [
            "lib/functions.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
