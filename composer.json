{
  "name": "hypejunction/hypestash",
  "type": "elgg-plugin",
  "description": "API for caching common counters to reduce DB queries",
  "homepage": "https://github.com/hypeJunction/Elgg3-hypeStash",
  "keywords": [
    "elgg",
    "plugin"
  ],
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Ismayil Khayredinov",
      "email": "ismayil.khayredinov@gmail.com"
    }
  ],
  "extra": {
    "installer-name": "hypestash",
    "elgg-plugin": {
      "id": "hypestash"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-intl": "*",
    "elgg/elgg": "~7.0.0",
    "composer/installers": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "hypeJunction\\Stash\\": "classes/hypeJunction/Stash/"
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  },
  "version": "3.0"
}
